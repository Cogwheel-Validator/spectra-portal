FROM golang:1.27.2 AS builder
WORKDIR /app
COPY ./go.mod /app
COPY ./go.sum /app
COPY ./pathfinder /app/pathfinder
COPY ./config_manager /app/config_manager
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOTOOLCHAIN=auto go build -ldflags="-s -w" -o pathfinder-rpc ./pathfinder/cmd/main.go

FROM gcr.io/distroless/base-debian13:latest@sha256:f5e95195e998742ff590b7569bae479accce1226e51ae6c3118954030121cdcb
WORKDIR /app
COPY --from=builder /app/pathfinder-rpc /app/pathfinder-rpc

USER nonroot

ENTRYPOINT ["./pathfinder-rpc"]
EXPOSE 8080
CMD ["--config-chains=/app/generated_configs/pathfinder_config.toml"]
