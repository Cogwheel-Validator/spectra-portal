FROM node:24.22.1-alpine AS base
RUN corepack enable && corepack prepare pnpm@12 --activate

FROM base AS deps

WORKDIR /app
COPY ./client_app/package.json ./client_app/pnpm-lock.yaml ./client_app/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM deps AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY ./client_app/ .
COPY ./generated_configs/client_config.toml ./client_config.toml

ENV NODE_ENV=production
ENV DOCKER_BUILD=true
ENV CI=true

RUN pnpm run build

FROM debian:13-slim AS tini-getter
RUN apt-get update && apt-get install -y tini --no-install-recommends

# Google does not publish versioned node tags; the digest pins the build and dependabot bumps it
FROM gcr.io/distroless/nodejs24-debian13:latest@sha256:51eee69b25037942014428da85f5b436a4d88f283e545981d03f25b7db72469a AS distroless

WORKDIR /app

COPY --from=builder --chown=nextjs:nonroot /app/client_config.toml ./client_config.toml
COPY --from=builder --chown=nextjs:nonroot /app/.next/standalone/ ./
COPY --from=builder --chown=nextjs:nonroot /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nonroot /app/public ./public
COPY --from=tini-getter /usr/bin/tini /sbin/tini

EXPOSE 3000

USER nonroot
ENV HOST=0.0.0.0
ENV PORT=3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/nodejs/bin/node", "server.js"]
